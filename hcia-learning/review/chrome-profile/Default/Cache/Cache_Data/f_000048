 const row=(cells,cls='')=>`<tr class="${cls}">${cells.map(x=>`<td>${x}</td>`).join('')}</tr>`;
 const ipnum=ip=>{if(!/^(\d{1,3}\.){3}\d{1,3}$/.test(ip)||ip.split('.').some(x=>+x>255))throw Error('请输入四段 0–255 的 IPv4 地址');return ip.split('.').reduce((n,x)=>n*256+Number(x),0);};
 const ipstr=n=>[24,16,8,0].map(s=>(n>>>s)&255).join('.');
 const subnet=(ip,p)=>{const n=ipnum(ip),size=2**(32-p),net=Math.floor(n/size)*size,b=net+size-1;return {n,size,net,b,mask:ipstr(p===0?0:(0xffffffff<<(32-p))>>>0),hosts:p<=30?size-2:p===31?2:1};};
 function stop(){if(timer)clearInterval(timer);timer=null;}
 function stepper(steps,draw){let i=0;$('#lab-work').innerHTML='<div id="dynamic-stage" class="lab-stage"></div><div class="lab-controls"><button id="step-reset" aria-label="回到第一步">↺ 重置</button><button id="step-back">← 上一步</button><button id="step-play" class="primary">▶ 自动播放</button><button id="step-next">下一步 →</button><span id="step-count" class="step-counter"></span></div><div id="step-explain" class="explanation" aria-live="polite"></div>';const paint=()=>{draw(i,$('#dynamic-stage'));$('#step-explain').textContent=steps[i];$('#step-count').textContent=`${i+1} / ${steps.length}`;$('#step-back').disabled=i===0;$('#step-next').disabled=i===steps.length-1;};const halt=()=>{stop();$('#step-play').textContent='▶ 自动播放';};$('#step-next').onclick=()=>{halt();i=Math.min(i+1,steps.length-1);paint();};$('#step-back').onclick=()=>{halt();i=Math.max(0,i-1);paint();};$('#step-reset').onclick=()=>{halt();i=0;paint();};$('#step-play').onclick=()=>{if(timer){halt();return;}if(i===steps.length-1)i=0;paint();$('#step-play').textContent='Ⅱ 暂停';timer=setInterval(()=>{i++;if(i>=steps.length-1){i=steps.length-1;halt();}paint();},1900);};paint();}
 const challenges={
