 function challenge(id){const [q,opts,ans,exp]=challenges[id];$('#lab-challenge').innerHTML=`<span class="eyebrow">动手之后 · 检验理解</span><h3>${q}</h3><div class="options">${opts.map((x,i)=>`<button class="option" data-lab-answer="${i}"><span class="letter">${String.fromCharCode(65+i)}</span>${x}</button>`).join('')}</div><div id="lab-feedback" aria-live="polite"></div>`;document.querySelectorAll('[data-lab-answer]').forEach(b=>b.onclick=()=>{const ok=+b.dataset.labAnswer===ans;document.querySelectorAll('[data-lab-answer]').forEach(x=>{x.classList.toggle('correct',+x.dataset.labAnswer===ans);x.classList.toggle('incorrect',x===b&&!ok);});$('#lab-feedback').innerHTML=`<div class="answer-feedback"><strong>${ok?'回答正确！':'再看一遍关键区别'}</strong><br>${exp}</div>`;if(ok&&window.markLab)window.markLab(id);});}
 function encap(){const steps=['应用程序生成“你好，网络！”这条消息。此时的 PDU 是应用数据 Data。','传输层加 TCP 头：源/目的端口、序号、确认与窗口。应用数据成为 TCP 的载荷，得到 Segment。','网络层加 IP 头，写源和目的 IP。整个 TCP 段成为 IP 载荷，得到 Packet。','以太网加 MAC 头与 FCS 尾部，得到 Frame；MAC 决定本链路的下一跳。','物理层把帧编码为电、光或无线信号，发送比特流。','中间路由器移除入链路头尾，查路由、递减 TTL，再为下一链路重新封装，TCP 数据不会因此重新建立连接。','接收主机按链路层 → IP → TCP → 应用解封装，最终应用得到原消息。'];stepper(steps,(i,el)=>{const layers=['应用层 · Data','传输层 · Segment','网络层 · Packet','链路层 · Frame','物理层 · Bit'];let blocks='<span class="packet-block data">你好，网络！</span>';if(i>=1&&i<6)blocks='<span class="packet-block tcp">TCP</span>'+blocks;if(i>=2&&i<6)blocks='<span class="packet-block ip">IP</span>'+blocks;if(i>=3&&i<6)blocks=`<span class="packet-block eth">${i===5?'新 MAC':'MAC'}</span>${blocks}<span class="packet-block eth">FCS</span>`;if(i===4)blocks='<span class="packet-block mono">01001000 01100101 01101100 01101100…</span>';el.innerHTML=`<div class="stack">${layers.map((x,n)=>`<div class="stack-layer ${n===Math.min(i,4)?'active':''}"><b>${x.split(' · ')[0]}</b><span>${x.split(' · ')[1]}</span><span style="margin-left:auto">${n<=i?'✓':'○'}</span></div>`).join('')}</div><div class="packet-visual">${blocks}</div><div class="caption">${i===6?'原消息已经送达接收应用':i===5?'逐跳更换二层封装 · 最终目的 IP 保持':'每一层把上层的整个 PDU 当作载荷'}</div>`;});}
 function tcp(){const modes={handshake:{label:'三次握手',steps:['客户端发送 SYN：Seq=100，请求建立连接。SYN 占 1 个序列号。','服务端回应 SYN+ACK：Seq=300，Ack=101，同时公布自己的初始序号。','客户端回应 ACK：Seq=101，Ack=301。服务端收到后双方建立连接。'],msgs:[['→','SYN · Seq=100'],['←','SYN + ACK · Seq=300 · Ack=101'],['→','ACK · Seq=101 · Ack=301']]},data:{label:'序号与窗口',steps:['客户端 Seq=101 发送 12 字节，对应字节 101–112。接收窗口示意为 20 字节。','服务端累计确认 Ack=113，表示下一期待第 113 字节；缓存剩余 8 字节。','服务端应用读走缓存，通告 Window=20。窗口更新不消耗新的数据序列号。','客户端 Seq=113 再发送 8 字节（113–120）；注意按字节编号，不是按段编号。','服务端 Ack=121，已累计收到到 120。窗口示意强调流量控制，不等同于拥塞窗口。'],msgs:[['→','Seq=101 · Data=12 B'],['←','ACK=113 · Window=8 B'],['←','ACK=113 · Window=20 B'],['→','Seq=113 · Data=8 B'],['←','ACK=121 · Window=12 B']]},close:{label:'四次挥手',steps:['A 不再发送：FIN+ACK，Seq=101，Ack=301。FIN 占用一个序列号。','B 确认：Seq=301，Ack=102。此时 B 仍可发送剩余数据。','本示例 B 无额外数据，发送 FIN+ACK：Seq=301，Ack=102。','A 确认 Ack=302。两个方向都关闭；实际 FIN 与 ACK 有时可以合并。'],msgs:[['→','FIN + ACK · Seq=101 · Ack=301'],['←','ACK · Seq=301 · Ack=102'],['←','FIN + ACK · Seq=301 · Ack=102'],['→','ACK · Seq=102 · Ack=302']]}};$('#lab-extra').innerHTML='<div class="tabs" id="tcp-tabs">'+Object.entries(modes).map(([k,v])=>`<button data-mode="${k}">${v.label}</button>`).join('')+'</div>';const show=k=>{stop();document.querySelectorAll('[data-mode]').forEach(b=>b.classList.toggle('active',b.dataset.mode===k));const m=modes[k];stepper(m.steps,(i,el)=>{el.innerHTML=`<svg viewBox="0 0 630 280" role="img" aria-label="${m.label}通信时序"><defs><marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto-start-reverse"><path d="M0,0 L8,4 L0,8" fill="#3777df"/></marker></defs><rect x="45" y="7" width="100" height="36" rx="8" fill="#e0ebff"/><rect x="485" y="7" width="100" height="36" rx="8" fill="#e0ebff"/><text x="95" y="30" text-anchor="middle" font-size="13" fill="#456b9f">客户端 A</text><text x="535" y="30" text-anchor="middle" font-size="13" fill="#456b9f">服务端 B</text><path d="M95 48 V270 M535 48 V270" stroke="#bfd0e8" stroke-dasharray="4 4"/>${m.msgs.map(([dir,t],n)=>n<=i?`<g opacity="${n===i?1:.38}"><path d="M${dir==='→'?100:530} ${75+n*43} H${dir==='→'?530:100}" stroke="#3777df" stroke-width="2" marker-end="url(#arrow)" class="${n===i?'flow-line':''}"/><text x="315" y="${66+n*43}" text-anchor="middle" font-size="12" fill="#456b9f">${h(t)}</text></g>`:'').join('')}</svg>`;});};document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>show(b.dataset.mode));show('handshake');}
 function arp(){$('#lab-extra').innerHTML='<label class="field">投递场景<select id="arp-mode"><option value="local">同子网：192.168.1.10 → 192.168.1.20</option><option value="remote">跨子网：192.168.1.10 → 10.1.1.20</option></select></label>';const show=()=>{stop();const remote=$('#arp-mode').value==='remote',target=remote?'网关 192.168.1.1':'B 192.168.1.20';stepper([`A 先看掩码 /24，判断目的${remote?'不在':'在'}本地子网，因此需要 ${target} 的 MAC。`,`A 查 ARP 缓存，当前没有 ${target} 的映射，发起 ARP 查询。`,`ARP Request 广播：以太网目的 MAC=FF-FF-FF-FF-FF-FF；ARP 内容中的未知目标 MAC=00-00-00-00-00-00。`,`交换机向本 VLAN 的其他端口泛洪，只有 IP 匹配的 ${target} 正常应答。`,`${target} 单播 ARP Reply，告知自己的 MAC，并学习 A 的 IP→MAC。`,`A 缓存映射后发数据：${remote?'目的 IP=10.1.1.20，帧目的 MAC=网关 MAC；网关再继续路由。':'目的 IP=192.168.1.20，帧目的 MAC=B 的 MAC。'}`],(i,el)=>{el.innerHTML=`<div class="nodebox">${node('主机 A','192.168.1.10')}<div class="wire ${i===4?'reverse':''}"></div>${node('二层交换机','同一 VLAN','▰')}<div class="wire ${i===4?'reverse':''}"></div>${node(remote?'默认网关':'主机 B',remote?'192.168.1.1':'192.168.1.20',remote?'◎':'▣')}</div><div class="packet-visual"><span class="packet-block ${i===2||i===3?'ip':'eth'}">${['比较网络号','查 ARP 缓存','广播 Request','同 VLAN 泛洪','单播 Reply','单播数据'][i]}</span></div>${table(['A 的 ARP 缓存','MAC 地址'],[row([remote?'192.168.1.1':'192.168.1.20',i>=4?(remote?'00-AA-00-00-00-01':'00-BB-00-00-00-20'):'（尚未学习）'])])}${remote?'<p class="caption">最终目标 10.1.1.20 在网关后方，不属于本次广播范围。</p>':''}`;});};$('#arp-mode').onchange=show;show();}
 function switching(){let learned={},count=0;$('#lab-work').innerHTML=`<div class="lab-stage"><div class="fields"><label class="field">设备<select id="switch-mode"><option value="switch">二层交换机</option><option value="hub">集线器 Hub</option></select></label><label class="field">发送方向<select id="switch-pair"><option value="AB">A → B</option><option value="BA">B → A</option><option value="AC">A → C</option><option value="CA">C → A</option><option value="AX">A → 广播</option></select></label></div><div id="switch-drawing"></div><div id="switch-table"></div></div><div class="lab-controls"><button id="switch-send" class="primary">发送一帧 →</button><button id="switch-reset">清空 MAC 表</button><span id="switch-count" class="step-counter"></span></div><div class="explanation" id="switch-explain" aria-live="polite">先发 A→B，再发 B→A，观察交换机如何从源 MAC 学习端口。</div>`;const paint=(src=null,outs=[])=>{$('#switch-drawing').innerHTML=`<svg viewBox="0 0 600 180" role="img" aria-label="交换机的三个端口连接主机 A B C"><rect x="242" y="62" width="116" height="54" rx="9" fill="#dce9ff"/><text x="300" y="94" text-anchor="middle" fill="#456b9f" font-size="13">${$('#switch-mode').value==='switch'?'Switch':'Hub'}</text>${[['A',70,90,1],['B',530,45,2],['C',530,145,3]].map(([n,x,y,port])=>`<path d="M${x} ${y} L300 90" stroke="${outs.includes(n)?'#27a781':src===n?'#3e79eb':'#c4d4ec'}" stroke-width="${outs.includes(n)||src===n?3:2}" class="${outs.includes(n)?'flow-line':''}"/><circle cx="${x}" cy="${y}" r="23" fill="#fff" stroke="#95afd5"/><text x="${x}" y="${y+5}" text-anchor="middle" font-size="13" fill="#456b9f">${n}</text><text x="${x}" y="${y+42}" text-anchor="middle" font-size="10" fill="#889fbe">端口 ${port} · MAC-${n}</text>`).join('')}</svg>`;$('#switch-table').innerHTML=table(['MAC 地址','端口'],Object.entries(learned).length?Object.entries(learned).map(([k,v])=>row(['MAC-'+k,v])):[row(['（空）','—'])]);$('#switch-count').textContent=`已发送 ${count} 帧`;};$('#switch-send').onclick=()=>{const [src,dst]=$('#switch-pair').value;const mode=$('#switch-mode').value;count++;let outs,msg;if(mode==='hub'){outs=['A','B','C'].filter(x=>x!==src);msg='Hub 不学习地址，只把信号复制到其他端口。';}else{learned[src]={A:1,B:2,C:3}[src];outs=learned[dst]?[dst]:['A','B','C'].filter(x=>x!==src);msg=`先学习 MAC-${src} → 端口 ${learned[src]}。${dst==='X'?'广播帧需泛洪。':learned[dst]?`目的 MAC-${dst} 已知，单播到端口 ${learned[dst]}。`:`目的 MAC-${dst} 未知，向除入端口外的端口泛洪。`}`;}paint(src,outs);$('#switch-explain').textContent=msg;};$('#switch-reset').onclick=()=>{learned={};count=0;paint();$('#switch-explain').textContent='MAC 表已清空。可以重新观察未知单播的泛洪。';};$('#switch-mode').onchange=()=>{$('#switch-reset').click();};paint();}
 function topology(){const coords=[[300,95],[115,42],[485,42],[115,230],[485,230]],names=['中心','A','B','C','D'];const graphs={star:[[0,1],[0,2],[0,3],[0,4]],ring:[[0,1],[1,2],[2,3],[3,4],[4,0]],mesh:Array.from({length:5},(_,a)=>Array.from({length:4-a},(_,n)=>[a,a+n+1])).flat()};let cut=-1;$('#lab-work').innerHTML='<div class="lab-stage"><div class="fields"><label class="field">拓扑<select id="topo-type"><option value="star">星型</option><option value="ring">环型（路径连通示意）</option><option value="mesh">全网状</option></select></label><label class="field">断开一条链路<select id="topo-cut"></select></label></div><div id="topo-svg"></div><div id="topo-result" class="caption"></div></div><div class="explanation" style="margin-top:17px">改变拓扑或断开链路，观察从 A 出发的可达节点。此实验计算物理图的连通性；实际二层网络还需 STP 等协议控制环路。</div>';const paint=()=>{const edges=graphs[$('#topo-type').value];const seen=new Set([1]);let changed=true;while(changed){changed=false;edges.forEach(([a,b],n)=>{if(n===cut)return;if(seen.has(a)&&!seen.has(b)){seen.add(b);changed=true;}if(seen.has(b)&&!seen.has(a)){seen.add(a);changed=true;}});}$('#topo-svg').innerHTML=`<svg viewBox="0 0 600 285" role="img" aria-label="网络拓扑，绿色表示从 A 可达">${edges.map(([a,b],n)=>`<path d="M${coords[a].join(' ')} L${coords[b].join(' ')}" stroke="${n===cut?'#e28291':'#b0c6e7'}" stroke-width="${n===cut?3:2}" stroke-dasharray="${n===cut?'6 6':'0'}"/>`).join('')}${coords.map(([x,y],n)=>`<circle cx="${x}" cy="${y}" r="25" fill="${seen.has(n)?'#e0f5ed':'#ffe9ed'}" stroke="${seen.has(n)?'#6fbea1':'#d893a0'}"/><text x="${x}" y="${y+5}" text-anchor="middle" font-size="12" fill="#4e7398">${names[n]}</text>`).join('')}</svg>`;$('#topo-result').textContent=`完整图 ${edges.length} 条链路 · 当前 ${edges.length-(cut>=0?1:0)} 条 · 从 A 可达 ${seen.size}/5 个节点`;};const reset=()=>{cut=-1;const ed=graphs[$('#topo-type').value];$('#topo-cut').innerHTML='<option value="-1">全部正常</option>'+ed.map(([a,b],i)=>`<option value="${i}">${names[a]} ↔ ${names[b]}</option>`).join('');paint();};$('#topo-type').oncha