 function subnetLab(){$('#lab-work').innerHTML=`<div class="lab-stage"><div class="fields"><label class="field">IPv4 地址<input id="subnet-ip" value="192.168.10.100" spellcheck="false"></label><label class="field">前缀长度 <b id="prefix-label">/26</b><input id="subnet-prefix" type="range" min="0" max="32" value="26"></label></div><div class="spread"><span class="pill">蓝色：网络位</span><span class="pill orange">橙色：主机位</span></div><div id="subnet-bits" class="bits"></div><div id="subnet-results"></div><div id="subnet-partitions"></div></div><div class="lab-controls"><button id="subnet-paper" class="primary">载入原卷：192.168.40.0/25</button><button id="subnet-random">换一个地址练习</button></div><div id="subnet-explain" class="explanation" aria-live="polite"></div>`;const paint=()=>{const p=+$('#subnet-prefix').value;$('#prefix-label').textContent='/'+p;try{const ip=$('#subnet-ip').value.trim(),s=subnet(ip,p);$('#subnet-bits').innerHTML=s.n.toString(2).padStart(32,'0').split('').map((b,i)=>`<span class="bit ${i>=p?'host':''}" title="第 ${i+1} 位：${i<p?'网络':'主机'}位">${b}</span>`).join('');$('#subnet-results').innerHTML='<div class="result-grid">'+[['子网掩码',s.mask],['网络地址 / 前缀',ipstr(s.net)+'/'+p],[p>=31?'地址块末地址（非普通广播）':'广播地址',ipstr(s.b)],['可用地址数',s.hosts.toLocaleString()],['可用起点',ipstr(p<=30?s.net+1:s.net)],['可用终点',ipstr(p<=30?s.b-1:s.b)]].map(([k,v])=>`<div class="result-tile"><small>${k}</small><strong>${v}</strong></div>`).join('')+'</div>';let blocks='';if(p>=24&&p<=28){const base=Math.floor(s.n/256)*256;blocks='<p class="notice">当前 /24 地址块中的 /'+p+' 分区（高亮为本地址所在块）</p><div class="subnet-blocks">'+Array.from({length:2**(p-24)},(_,i)=>{const n=base+i*s.size;return `<div class="${n===s.net?'chosen':''}">.${n%256}–.${(n+s.size-1)%256}</div>`;}).join('')+'</div>';}$('#subnet-partitions').innerHTML=blocks;$('#subnet-explain').textContent=p<=30?`主机位 h=32−${p}=${32-p}，总地址 2^${32-p}=${s.size.toLocaleString()}；普通子网减去网络与广播两端，剩 ${s.hosts.toLocaleString()}。网络地址由 IP AND 掩码得到。`:`/${p} 为特殊边界：${p===31?'点到点 /3